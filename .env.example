# Copy to .env and adjust. Never commit .env.
#
# psycopg3 driver. The same URL serves the async app (via create_async_engine)
# and Alembic's sync migration runner - psycopg3 supports both modes, so there
# is only ever one connection string to keep correct.
#
# PORT 5433, NOT 5432. A native PostgreSQL 18 install on this machine already
# owns 5432 and holds the v1 project's live database. Pointing this project
# there would run its migrations against v1's real data.
DATABASE_URL=postgresql+psycopg://baseball:baseball@localhost:5433/baseball

# Tests CREATE and DROP this database on every run. It must never name a
# database with data you care about; conftest.py refuses to run if the name
# does not end in _test.
TEST_DATABASE_URL=postgresql+psycopg://baseball:baseball@localhost:5433/baseball_test

# Echo every SQL statement to stdout. Noisy; useful when a query is not
# using the index you think it is.
SQL_ECHO=false

# healthchecks.io ping URLs. Optional - absent means no ping, and a ping
# failure never fails a run (the call is wrapped in suppress()). Two checks,
# not one: the poller and the schedule job fail independently, and a single
# alert would let a broken schedule hide behind a healthy poll.
HEALTHCHECK_URL=
HEALTHCHECK_SCHEDULE_URL=
